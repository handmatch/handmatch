# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real keys to GitHub.

# Your live site address (no trailing slash)
SITE_URL=https://handmatch.us

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use sk_test_ first, then sk_live_)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Resend → API Keys
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "handmatch <hello@handmatch.us>"
FROM_EMAIL=handmatch <onboarding@resend.dev>
# Where new sign-up and payment alerts go
TEAM_EMAIL=hello.handmatch@gmail.com
