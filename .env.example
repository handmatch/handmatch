# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real keys to GitHub.

# Your live site address (no trailing slash)
SITE_URL=https://handmatch.us

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use sk_test_ first, then sk_live_)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Resend → API Keys
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "handmatch <hello@handmatch.us>"
FROM_EMAIL=handmatch <onboarding@resend.dev>
# Where new sign-up and payment alerts go
TEAM_EMAIL=hello.handmatch@gmail.com

# Optional: live copy of sign-ups in Google Sheets (see integrations/google-sheets/Code.gs)
SHEETS_WEBHOOK_URL=
SHEETS_TOKEN=

# Web app (logins and dashboards). See ARCHITECTURE.md
# 40+ random characters; use a different value for staging and production
SESSION_SECRET=
# Comma-separated emails that get every team role (Admin, Concierge, Recruiter,
# Finance, Compliance) the first time they sign in. Add everyone else in Admin → Team.
ADMIN_EMAILS=
# Concierge assigned to new placements (optional; otherwise the first Concierge)
DEFAULT_CONCIERGE_EMAIL=
# Set to 1 to let Stripe payments open placements and to only sell in sellable territories
APP_ENABLED=
# Referral bonus in cents (optional, default 5000 = $50)
REFERRAL_BONUS_CENTS=
